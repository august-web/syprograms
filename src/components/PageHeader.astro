---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	subtitle?: string;
	eyebrow?: string;
	image?: ImageMetadata;
	imageAlt?: string;
}

const { title, subtitle, eyebrow, image, imageAlt = '' } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-navy-900 py-32 text-white sm:py-36">
	{
		image && (
			<div class="absolute inset-0 -z-20 overflow-hidden">							<Image
					src={image}
					alt={imageAlt}
					class="h-full w-full object-cover"
					loading="eager"
					widths={[800, 1200, 1600, 2000]}
					sizes="100vw"
				/>
			</div>
		)
	}
	<div class="absolute inset-0 -z-10" aria-hidden="true">
		<div class:list={['absolute inset-0 bg-gradient-to-b', image ? 'from-navy-950/85 via-navy-950/60 to-navy-950' : 'from-navy-950/40 via-transparent to-navy-950/80']}></div>
	</div>

	<div class="container-site">
		{
			eyebrow && (
				<p class="flex items-center gap-3 font-display text-sm font-bold uppercase tracking-[0.25em] text-cyan-300">
					<span class="inline-block h-px w-10 bg-gradient-to-r from-cyan-300 to-transparent" aria-hidden="true" />
					{eyebrow}
				</p>
			)
		}
		<h1 class="mt-4 max-w-3xl font-display text-5xl font-bold leading-[1.05] sm:text-6xl">
			{title}
		</h1>
		{
			subtitle && (
				<p class="mt-5 max-w-2xl text-lg leading-relaxed text-navy-100">
					{subtitle}
				</p>
			)
		}
	</div>
</section>
