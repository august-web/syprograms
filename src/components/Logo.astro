---
interface Props {
	class?: string;
}

const { class: className = 'h-9 w-9' } = Astro.props;
---

<svg class={className} viewBox="0 0 64 64" role="img" aria-label="SYP — Southside Youth Programs">
	<rect width="64" height="64" rx="14" fill="#E5C338"></rect>
	<text
		x="17"
		y="44"
		text-anchor="middle"
		font-size="27"
		font-weight="700"
		fill="#D63F2E"
		style="font-family: var(--font-display, Georgia), Georgia, 'Times New Roman', serif;">S</text
	>
	<text
		x="32"
		y="38"
		text-anchor="middle"
		font-size="27"
		font-weight="700"
		fill="#66BFA3"
		style="font-family: var(--font-display, Georgia), Georgia, 'Times New Roman', serif;">Y</text
	>
	<text
		x="47"
		y="45"
		text-anchor="middle"
		font-size="27"
		font-weight="700"
		fill="#1E2235"
		style="font-family: var(--font-display, Georgia), Georgia, 'Times New Roman', serif;">P</text
	>
</svg>
