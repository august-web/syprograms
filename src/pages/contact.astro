---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import {
	SITE_NAME,
	PHONE_MAIN,
	PHONE_MAIN_HREF,
	EMAIL_MAIN,
	MAILTO_MAIN,
	ADDRESS_STREET,
	ADDRESS_LOCALITY,
	mailtoLink,
} from '../data/site';
---

<Base
	title="Contact"
	description={`Contact ${SITE_NAME} in Houston — call 281-536-8292, email southside917@aol.com, or use our email form. 7210 Peerless St, Suite B, Houston, TX.`}
>
	<PageHeader
		eyebrow="Get in touch"
		title="Contact us"
		subtitle="Call, email, or use the form below — we usually respond within a day or two."
	/>

	<section class="relative py-24">
		<div class="container-site grid gap-12 lg:grid-cols-5">
			<!-- Contact details -->
			<div class="space-y-8 lg:col-span-2">
				{
					[
						{
							title: 'Call or email',
							body: (
								<ul class="mt-3 space-y-2 text-slate-700">
									<li>
										Phone: <a class="link-sweep font-bold text-cyan-600" href={PHONE_MAIN_HREF}>{PHONE_MAIN}</a> (Lynn)
									</li>
									<li>
										Email: <a class="link-sweep font-bold text-cyan-600" href={MAILTO_MAIN}>{EMAIL_MAIN}</a>
									</li>
								</ul>
							),
						},
						{
							title: 'Visit us',
							body: (
								<>
									<p class="mt-3 text-slate-700">
										{ADDRESS_STREET}<br />
										{ADDRESS_LOCALITY}
									</p>
									<p class="mt-2 text-sm text-slate-500">After-school hours: Mon–Thu, 4:00–6:00 PM</p>
								</>
							),
						},
						{
							title: 'IMCO program',
							body: (
								<p class="mt-3 text-slate-700">
									Questions about the Baylor medical careers program? Contact Oliver at{' '}
									<a class="link-sweep font-bold text-cyan-600" href="tel:+18325205031">832-520-5031</a>.
								</p>
							),
						},
					].map((block, i) => (
						<div>
							<h2 class="font-display text-2xl font-bold text-navy-600">{block.title}</h2>
							{block.body}
						</div>
					))
				}
			</div>

			<!-- mailto form -->
			<div class="lg:col-span-3">
				<div class="glass-light relative overflow-hidden rounded-[2rem] p-6 shadow-2xl shadow-navy-900/10 sm:p-10">
					<div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-navy-500 via-cyan-400 to-navy-500" aria-hidden="true"></div>

					<h2 class="font-display text-3xl font-bold text-navy-600">Send us a message</h2>
					<p class="mt-2 text-sm text-slate-600">
						This form opens your email app with everything filled in — just hit send.
						No data is collected on this website.
					</p>

					<form id="contact-form" class="mt-8 space-y-5" novalidate>
						<div class="grid gap-5 sm:grid-cols-2">
							<div>
								<label for="cf-name" class="block text-sm font-bold text-navy-700">Your name <span class="text-cyan-500">*</span></label>
								<input
									id="cf-name"
									name="name"
									type="text"
									required
									autocomplete="name"
									class="mt-1.5 block w-full rounded-xl border border-navy-100 bg-white/80 px-4 py-3 transition-all duration-300 focus:border-cyan-400 focus:shadow-[0_0_0_4px_rgba(41,180,207,0.15)] focus:outline-none"
								/>
							</div>
							<div>
								<label for="cf-email" class="block text-sm font-bold text-navy-700">Your email <span class="text-cyan-500">*</span></label>
								<input
									id="cf-email"
									name="email"
									type="email"
									required
									autocomplete="email"
									class="mt-1.5 block w-full rounded-xl border border-navy-100 bg-white/80 px-4 py-3 transition-all duration-300 focus:border-cyan-400 focus:shadow-[0_0_0_4px_rgba(41,180,207,0.15)] focus:outline-none"
								/>
							</div>
						</div>

						<div>
							<label for="cf-subject" class="block text-sm font-bold text-navy-700">Subject</label>
							<select
								id="cf-subject"
								name="subject"
								class="mt-1.5 block w-full rounded-xl border border-navy-100 bg-white/80 px-4 py-3 transition-all duration-300 focus:border-cyan-400 focus:shadow-[0_0_0_4px_rgba(41,180,207,0.15)] focus:outline-none"
							>
								<option>General question</option>
								<option>After-school program</option>
								<option>IMCO — medical careers</option>
								<option>Volunteering</option>
								<option>Something else</option>
							</select>
						</div>

						<div>
							<label for="cf-message" class="block text-sm font-bold text-navy-700">Message <span class="text-cyan-500">*</span></label>
							<textarea
								id="cf-message"
								name="message"
								rows="5"
								required
								class="mt-1.5 block w-full resize-y rounded-xl border border-navy-100 bg-white/80 px-4 py-3 transition-all duration-300 focus:border-cyan-400 focus:shadow-[0_0_0_4px_rgba(41,180,207,0.15)] focus:outline-none"
							></textarea>
						</div>

						<button
							type="submit"
							class="w-full rounded-full bg-gradient-to-r from-navy-500 to-navy-400 px-8 py-4 font-bold text-white shadow-lg shadow-navy-500/25 transition-transform duration-300 hover:scale-[1.02] sm:w-auto"
						>
							Open email &amp; send
						</button>

						<p id="cf-status" class="hidden rounded-xl bg-cyan-50 p-4 text-sm text-navy-700" role="status"></p>
					</form>
				</div>
			</div>
		</div>
	</section>
</Base>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const status = document.getElementById('cf-status');

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		if (!form.reportValidity()) return;

		const data = new FormData(form);
		const name = String(data.get('name') ?? '').trim();
		const email = String(data.get('email') ?? '').trim();
		const subject = String(data.get('subject') ?? 'General question');
		const message = String(data.get('message') ?? '').trim();

		const body = [
			`Hi ${'Southside Youth Programs'},`,
			'',
			message,
			'',
			'—',
			`Name: ${name}`,
			`Email: ${email}`,
			`(Sent from the syprograms.org contact form)`,
		].join('\n');

		const href = mailtoLink({ subject: `[syprograms.org] ${subject}`, body });
		window.location.href = href;

		if (status) {
			status.classList.remove('hidden');
			status.textContent =
				"Your email app should open with the message ready to send. If nothing happened, email us directly at southside917@aol.com.";
		}
	});
</script>
