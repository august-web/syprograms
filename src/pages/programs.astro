---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { Image } from 'astro:assets';
import { programs } from '../data/programs';
import {
	PHONE_MAIN,
	PHONE_MAIN_HREF,
	PHONE_IMCO,
	PHONE_IMCO_HREF,
	MAILTO_IMCO,
} from '../data/site';

const IMCO_SIGNUP_URL =
	'https://docs.google.com/forms/d/e/1FAIpQLSeNA1TSsuKnWI9pUnRZrzAxtQZLDCa-uau0RCefvh8AmYQLhg/viewform?usp=dialog';
---

<Base
	title="Programs"
	description="After-school care Mon–Thu, the Baylor IMCO medical careers program, music classes, arts and creativity, and culinary workshops for Southside Houston youth."
>
	<PageHeader
		eyebrow="Enrolling now"
		title="Our programs"
		subtitle="Five programs for Southside youth, after the school day ends."
	/>

	<section class="py-24">
		<div class="container-site space-y-24">
			{
				programs.map((program, index) => (
					<article
						class:list={[
							'grid items-center gap-10 lg:grid-cols-12 lg:gap-14',
							index % 2 === 1 && 'lg:[&>figure]:order-first',
						]}

					>
						<div class="lg:col-span-7">
							<h2 class="font-display text-3xl font-bold text-navy-600 sm:text-4xl">{program.name}</h2>
							<p class="mt-3 text-lg leading-relaxed text-slate-700">{program.summary}</p>
							<ul class="mt-6 space-y-3">
								{program.details.map((detail) => (
									<li class="flex items-start gap-3 text-slate-700">
										<span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-cyan-100" aria-hidden="true">
											<svg class="h-3 w-3 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
												<path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
											</svg>
										</span>
										{detail}
									</li>
								))}
							</ul>

							{program.slug === 'imco' && (
								<div class="glass-light mt-7 rounded-2xl p-6">
									<p class="font-bold text-navy-700">Ready to sign up?</p>
									<p class="mt-1 text-sm text-slate-600">
										Enrollment is limited. Contact Oliver at{' '}
										<a class="font-bold text-cyan-600 hover:text-cyan-500" href={PHONE_IMCO_HREF}>{PHONE_IMCO}</a> or{' '}
										<a class="font-bold text-cyan-600 hover:text-cyan-500" href={MAILTO_IMCO}>oraysteven@gmail.com</a>.
									</p>
									<a
										href={IMCO_SIGNUP_URL}
										target="_blank"
										rel="noopener noreferrer"
										class="mt-4 inline-flex rounded-full bg-gradient-to-r from-navy-500 to-navy-400 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-navy-500/30 transition-transform duration-300 hover:scale-[1.03]"
									>
										IMCO sign-up form ↗
									</a>
								</div>
							)}
						</div>							<figure class="group relative lg:col-span-5">
								<Image
									src={program.image}
									alt={program.alt}
									class="aspect-[4/3] w-full rounded-[2rem] object-cover shadow-xl shadow-navy-900/15"
								widths={[400, 800, 1200]}
								sizes="(min-width: 1024px) 40vw, 100vw"
							/>
						</figure>
					</article>
				))
			}
		</div>
	</section>

	<section class="relative isolate overflow-hidden bg-navy-950 py-20 text-white">
		<div class="container-site text-center">
			<h2 class="mx-auto max-w-2xl font-display text-3xl font-bold sm:text-4xl">
				Not sure which program fits? <span class="text-cyan-300">Call us and we'll help you choose.</span>
			</h2>
			<p class="mx-auto mt-4 max-w-xl text-navy-100">
				Call Lynn at <a class="link-sweep font-bold text-cyan-300" href={PHONE_MAIN_HREF}>{PHONE_MAIN}</a>
			</p>
			<a
				href="/contact/"
				class="mt-8 inline-flex rounded-full bg-gradient-to-r from-cyan-400 to-cyan-300 px-8 py-4 font-bold text-navy-900 shadow-xl shadow-cyan-500/30 transition-transform duration-300 hover:scale-[1.03]"

			>
				Contact us
			</a>
		</div>
	</section>
</Base>
